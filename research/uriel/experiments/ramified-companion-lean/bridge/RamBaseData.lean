import RamBaseModel
namespace RamBase
def repNo (j : ℕ) : ℕ := (( : ℕ) >>> (6*j)) % 64
def rootCode (j : ℕ) : ℕ := (( : ℕ) >>> (10*j)) % 1024
def invCode (j : ℕ) : ℕ := (( : ℕ) >>> (10*j)) % 1024
def repCode (j : ℕ) : ℕ := ((0xc3304a2280842088018c6198460944501184410c42104400c630cc2304a22808c22086210822006318446110431084110023088210801c050100380c0280801c060140400c0200400 : ℕ) >>> (10*j)) % 1024
def row0 (j : ℕ) : ℕ := ((0x1 : ℕ) >>> (1*j)) % 2
def row1 (j : ℕ) : ℕ := ((0x800000000000000000800000000000000000800000000000400000200000000000000000000020 : ℕ) >>> (6*j)) % 64
def row2 (j : ℕ) : ℕ := ((0x200100080040000010008000002000000800400200000080040000010008000000000000000200100000080040000010008000000000000800000000000080000010000004000000000800000000000000000000000000000000000000800 : ℕ) >>> (13*j)) % 8192
def row3 (j : ℕ) : ℕ := (( : ℕ) >>> (22*j)) % 4194304
def row4 (j : ℕ) : ℕ := (( : ℕ) >>> (32*j)) % 4294967296
def row5 (j : ℕ) : ℕ := (( : ℕ) >>> (42*j)) % 4398046511104
def row6 (j : ℕ) : ℕ := (( : ℕ) >>> (52*j)) % 4503599627370496

def validOrbit (t : ℕ) : Bool := decide (
  repNo t < 58 ∧
  decode (rootCode t) * decode (invCode t) = 1 ∧
  (decode (rootCode t))^2 * decode (repCode (repNo t)) = decode t)
set_option maxRecDepth 20000
set_option maxHeartbeats 0
theorem allOrbits : checks validOrbit 1024 = true := by decide +kernel

theorem reduce_to_rep (d : ℕ) (z : R) :
    TargetOne.count d z = TargetOne.count d (decode (repCode (repNo (encode z)))) := by
  have hh := of_decide_eq_true (select allOrbits (encode z) (encode_lt z))
  obtain ⟨_,hinv,hm⟩ := hh
  let u : Rˣ := ⟨_,_,hinv,mul_comm .. |>.trans hinv⟩
  have he : (u:R)^2 * decode (repCode (repNo (encode z))) = z :=
    hm.trans (decode_encode z)
  exact (congrArg (TargetOne.count d) he.symm).trans (orbit_count d _ u)

end RamBase
