import ReadableDatum
import WitnessInterface

open New Formalism.HC Formalism.FrobeniusOrbits
noncomputable section
namespace FixedDatum

theorem main_host_impossible {φ : Frame} (H : HostRaw φ) : H.d ≠ mainParameters.d := by
  intro h
  have h7 := H.hyp.2.2.2.1
  rw [h] at h7
  norm_num [mainParameters] at h7

/-- Keeping the quadratic prime already fails before any proposed TT is examined. -/
theorem fixed_obstruction : mainDatum.natX = fixedN ∧ mainDatum.bPlaces.Nonempty ∧
    ∀ (φ : Frame) (H : HostRaw φ), H.d ≠ mainParameters.d :=
  ⟨same_integer.1, at_least_one _, fun _ H => main_host_impossible H⟩

theorem obstruction_at_multiples_of_32 (P : Parameters) (hm : 32 ∣ P.q₀)
    {φ : Frame} (H : HostRaw φ) : H.d ≠ P.d := by
  intro h
  have h7 := H.hyp.2.2.2.1
  rw [h] at h7
  have hh := hm.trans P.q₀_dvd_and_not_dvd.1
  omega

theorem control_prime_test : HostHyp 11 controlParameters.d := by
  norm_num [HostHyp, controlParameters]

/-- The full place carrier has two elements per old A-index if the fields are identified. -/
theorem place_count {P : Parameters} (D : Data P) {φ : Frame} (H : HostAx φ)
    (e : H.E ≃ₐ[ℚ] D.E) : Fintype.card D.Φ = 2 * Fintype.card φ.A := by
  have h := e.toLinearEquiv.finrank_eq
  rw [H.der.finrank_E, readable_degree] at h
  rw [φ.card_A]
  omega

theorem no_place_equiv {P : Parameters} (D : Data P) {φ : Frame} (H : HostAx φ)
    (e : H.E ≃ₐ[ℚ] D.E) : ¬ Nonempty (D.Φ ≃ φ.A) := by
  rintro ⟨u⟩
  have hc := Fintype.card_congr u
  have hd := place_count D H e
  have hpos : 0 < Fintype.card φ.A := by rw [φ.card_A]; exact φ.ord_pos
  omega

/-- A literal cardinal comparison in the joint kernel. The frame hypothesis makes
    the projection injective on the cyclic subgroup generated by a0. -/
theorem no_identity_fiber_equiv {P : Parameters} (D : Data P) (φ : Frame) :
    ¬ Nonempty (D.aPlaces ≃ φ.A0) := by
  classical
  have hp : addOrderOf φ.a0 ∣ addOrderOf (φ.h φ.a0) := by
    apply addOrderOf_dvd_of_nsmul_eq_zero
    let k := addOrderOf (φ.h φ.a0)
    have hh : φ.h ((k : ℤ) • φ.a0) = 0 := by
      rw [map_zsmul, natCast_zsmul]
      exact addOrderOf_nsmul_eq_zero _
    simpa only [natCast_zsmul] using φ.zsmul_generator_eq_zero_of_image (k : ℤ) hh
  have hq : Nat.card (HGrp φ.e) ∣ Nat.card (ZMod (2 ^ (φ.e + 2)))ˣ :=
    Subgroup.card_quotient_dvd_card _
  have hcard : Nat.card (ZMod (2 ^ (φ.e + 2)))ˣ = 2 ^ (φ.e + 1) := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
        Nat.totient_prime_pow_succ Nat.prime_two (φ.e + 1)]
    simp
  rw [hcard] at hq
  have hdiv : Nat.card φ.A0 ∣ 2 ^ (φ.e + 1) := by
    rw [show Nat.card φ.A0 = addOrderOf φ.a0 from Nat.card_zmultiples _]
    exact hp.trans ((addOrderOf_dvd_natCard (φ.h φ.a0)).trans hq)
  rintro ⟨f⟩
  have hd : 3 ∣ Nat.card φ.A0 := by
    rw [← Nat.card_congr f, Nat.card_eq_fintype_card, Fintype.card_coe]
    exact three_dvd_identity_fiber D
  have hh := Nat.prime_three.dvd_of_dvd_pow (hd.trans hdiv)
  norm_num at hh

end FixedDatum
