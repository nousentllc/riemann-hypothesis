import SevenTransport
import Development.AutomorphicArithmetic.AutomorphicVarieties.NumberFieldTowers.IdealNormClassCongr
import Mathlib.NumberTheory.NumberField.Cyclotomic.Ideal
import Mathlib.NumberTheory.RamificationInertia.Unramified
import Mathlib.RingTheory.Ideal.Int

noncomputable section

namespace Seven.NextLayer

open NumberField Ideal Seven.CyclotomicTransport

local instance : Fact (Nat.Prime 7) := ⟨by decide⟩

/-- The bottom and top are the original consecutive layers, starting at the seventh roots. -/
abbrev Lower (k : ℕ) := Layer (k + 1)
abbrev Upper (k : ℕ) := Layer (k + 2)

/-- Use the same inclusion as the original class-group norm in the tower. -/
instance stepAlgebra (k : ℕ) : Algebra (Lower k) (Upper k) :=
  (IntermediateField.inclusion
    (UpperTheory.V.Tower.Fn_le_succ 7 Base (AlgebraicClosure Base) (k+1))).toRingHom.toAlgebra

private instance cyc (k : ℕ) : IsCyclotomicExtension {7 ^ (k + 1)} ℚ (Lower k) :=
  rational_cyclotomic (k+1) (by omega)

private instance gal (k : ℕ) : IsGalois ℚ (Lower k) :=
  IsCyclotomicExtension.isGalois {7 ^ (k+1)} ℚ (Lower k)

theorem step_galois (k : ℕ) : IsGalois (Lower k) (Upper k) :=
  IsGalois.tower_top_of_isGalois ℚ (Lower k) (Upper k)

theorem absolute_degree (k : ℕ) : Module.finrank ℚ (Lower k) = 7 ^ k * 6 := by
  rw [IsCyclotomicExtension.Rat.finrank (7 ^ (k+1)), Nat.totient_prime_pow_succ (by decide : Nat.Prime 7)]

theorem step_degree (k : ℕ) : Module.finrank (Lower k) (Upper k) = 7 := by
  have : Module.Free (Lower k) (Upper k) := Module.Free.of_divisionRing ..
  have h := Module.finrank_mul_finrank ℚ (Lower k) (Upper k)
  rw [absolute_degree k, absolute_degree (k+1), pow_succ] at h
  apply Nat.eq_of_mul_eq_mul_left (by positivity : 0 < 7 ^ k * 6)
  simpa only [Nat.mul_right_comm] using h

theorem step_group (k : ℕ) :
    Nat.card Gal(Upper k / Lower k) = 7 ∧ IsCyclic Gal(Upper k / Lower k) := by
  let _ := step_galois k
  have h := (IsGaloisGroup.card_eq_finrank Gal(Upper k / Lower k) (Lower k) (Upper k)).trans (step_degree k)
  exact ⟨h, isCyclic_of_prime_card h⟩

abbrev overPrime (q : ℕ) : Ideal ℤ := Ideal.span {(q : ℤ)}

theorem unique_over_seven (k : ℕ) : ((overPrime 7).primesOver (𝓞 (Lower k))).ncard = 1 :=
  IsCyclotomicExtension.Rat.ncard_primesOver_of_prime_pow 7 k (Lower k)

theorem ramification_seven (k : ℕ) (P : Ideal (𝓞 (Lower k))) [P.IsPrime] [P.LiesOver (overPrime 7)] :
    (P.primesOver (𝓞 (Upper k))).ncard = 1 ∧ P.ramificationIdxIn (𝓞 (Upper k)) = 7 ∧
      P.inertiaDegIn (𝓞 (Upper k)) = 1 := by
  let _ := step_galois k
  have hcount := ncard_primesOver_mul_ncard_primesOver (p := overPrime 7) P Gal(Lower k/ℚ)
    (𝓞 (Upper k)) Gal(Upper k/ℚ)
  rw [unique_over_seven k, unique_over_seven (k+1), one_mul] at hcount
  have he := ramificationIdxIn_mul_ramificationIdxIn (p := overPrime 7) P Gal(Lower k/ℚ)
    (𝓞 (Upper k)) Gal(Upper k/ℚ) Gal(Upper k/Lower k)
  rw [IsCyclotomicExtension.Rat.ramificationIdxIn_eq_of_prime_pow 7 k (Lower k),
    IsCyclotomicExtension.Rat.ramificationIdxIn_eq_of_prime_pow 7 (k+1) (Upper k), pow_succ] at he
  have hf := inertiaDegIn_mul_inertiaDegIn (overPrime 7) P Gal(Lower k/ℚ)
    (𝓞 (Upper k)) Gal(Upper k/ℚ) Gal(Upper k/Lower k)
  rw [IsCyclotomicExtension.Rat.inertiaDegIn_eq_of_prime_pow 7 k (Lower k),
    IsCyclotomicExtension.Rat.inertiaDegIn_eq_of_prime_pow 7 (k+1) (Upper k), one_mul] at hf
  refine ⟨hcount, ?_, hf⟩
  apply Nat.eq_of_mul_eq_mul_left (by positivity : 0 < 7 ^ k * (7-1))
  simpa only [Nat.mul_right_comm] using he

theorem unramified_away (k q : ℕ) [hp : Fact q.Prime] (hne : q ≠ 7)
    (P : Ideal (𝓞 (Lower k))) [P.IsPrime] [P.LiesOver (overPrime q)] :
    Algebra.IsUnramifiedIn (𝓞 (Upper k)) P := by
  apply Algebra.isUnramifiedIn_iff_forall_ramificationIdx_eq_one.mpr
  intro Q _ hQ
  have := Ideal.LiesOver.trans Q P (overPrime q)
  have hnd : ¬ q ∣ 7 ^ (k+2) := by
    intro hd
    have h3 := hp.out.dvd_of_dvd_pow hd
    exact hne ((Nat.dvd_prime (by decide : Nat.Prime 7)).mp h3 |>.resolve_left hp.out.ne_one)
  have he := IsCyclotomicExtension.Rat.ramificationIdx_eq_of_not_dvd q (Upper k) Q hnd
  rw [Ideal.ramificationIdx_tower P Q] at he
  exact Nat.eq_one_of_dvd_one (Dvd.intro_left _ he)

/-- All source fields occurring here have no real places. -/
theorem totally_complex (k : ℕ) : IsTotallyComplex (Lower k) := by
  apply IsCyclotomicExtension.Rat.isTotallyComplex (n := 7 ^ (k+1))
  have h : 0 < (7 : ℕ) ^ k := by positivity
  rw [pow_succ]
  omega

/-- The unique prime over seven is generated by the cyclotomic uniformizer. -/
theorem prime_over_seven_generator (k : ℕ) (P : Ideal (𝓞 (Lower k))) [P.IsPrime]
    [P.LiesOver (overPrime 7)] :
    P = Ideal.span {((IsCyclotomicExtension.zeta_spec (7 ^ (k+1)) ℚ (Lower k)).toInteger - 1)} :=
  IsCyclotomicExtension.Rat.eq_span_zeta_sub_one_of_liesOver 7 k (Lower k) _ P

theorem ramified_class_trivial (k : ℕ) (P : Ideal (𝓞 (Lower k))) [P.IsPrime]
    [P.LiesOver (overPrime 7)] (h0 : P ≠ ⊥) :
    ClassGroup.mk0 ⟨P, mem_nonZeroDivisors_of_ne_zero h0⟩ = 1 := by
  apply (ClassGroup.mk0_eq_one_iff _).mpr
  rw [prime_over_seven_generator k P]
  exact ⟨_, rfl⟩

theorem unramified_iff (k : ℕ) (P : Ideal (𝓞 (Lower k))) [P.IsPrime] (hP : P ≠ ⊥) :
    Algebra.IsUnramifiedIn (𝓞 (Upper k)) P ↔ ¬ P.LiesOver (overPrime 7) := by
  constructor
  · intro hu hl
    let _ := hl
    let _ := step_galois k
    obtain ⟨⟨Q, hQ, hQP⟩⟩ := P.nonempty_primesOver (S := 𝓞 (Upper k))
    have h3 := (ramification_seven k P).2.1
    rw [ramificationIdxIn_eq_ramificationIdx P Q Gal(Upper k/Lower k),
      hu.ramificationIdx_eq_one hQP] at h3
    contradiction
  · intro h
    let q := (P.under ℤ).absNorm
    have hne : NeZero P := ⟨hP⟩
    have hq : Fact q.Prime := ⟨Nat.absNorm_under_prime P⟩
    have hl : P.LiesOver (overPrime q) := Int.liesOver_span_absNorm P
    exact unramified_away k q (fun e => h (Eq.mp (congrArg (fun x => P.LiesOver (overPrime x)) e) hl)) P

/-- Exactly one nonzero prime downstairs ramifies in each actual source-field step. -/
theorem unique_ramified_prime (k : ℕ) :
    ∃! P : Ideal (𝓞 (Lower k)), P.IsPrime ∧ P ≠ ⊥ ∧ ¬ Algebra.IsUnramifiedIn (𝓞 (Upper k)) P := by
  classical
  obtain ⟨P, hp⟩ := Set.ncard_eq_one.mp (unique_over_seven k)
  have hm : P ∈ (overPrime 7).primesOver (𝓞 (Lower k)) := hp ▸ Set.mem_singleton _
  obtain ⟨hP, hP3⟩ := hm
  have h0 : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot (show overPrime 7 ≠ ⊥ by norm_num [overPrime]) P
  refine ⟨P, ⟨hP, h0, fun hu => (unramified_iff k P h0).mp hu hP3⟩, ?_⟩
  rintro Q ⟨hQ, hQ0, hram⟩
  have hl : Q.LiesOver (overPrime 7) := not_not.mp (hram ∘ (unramified_iff k Q hQ0).mpr)
  have hmem : Q ∈ (overPrime 7).primesOver (𝓞 (Lower k)) := ⟨hQ,hl⟩
  simpa only [hp, Set.mem_singleton_iff] using hmem

